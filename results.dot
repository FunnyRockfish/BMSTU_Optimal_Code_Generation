digraph G{
node [shape=box nojustify=false]
0 [label="BLOCK 0\l    new variable a\l    a(0) <- 1\l    new variable b\l    b(0) <- 2\l    tmp_0_0 <- a(0)\l    tmp_0_1 <- b(0)\l    tmp_0_2 <- tmp_0_0 > tmp_0_1\l    if (!tmp_0_2) go to BLOCK1 else go to BLOCK2"]
0 -> 1 [label=true]
0 -> 2 [label=false]
1 [label="BLOCK 1\l    new variable a\l    tmp_1_0 <- a(0)\l    tmp_1_1 <- tmp_1_0 sub 1\l    a(1) <- tmp_1_1\l    go to BLOCK3"]
1 -> 3
2 [label="BLOCK 2\l    new variable b\l    tmp_2_0 <- b(0)\l    tmp_2_1 <- tmp_2_0 sub 1\l    b(1) <- tmp_2_1\l    go to BLOCK3"]
2 -> 3
3 [label="BLOCK 3\l    b(2) = phi(b(0), b(1))\l    a(2) = phi(a(1), a(0))\l    new variable c\l    tmp_0_3 <- 0 sub 1\l    c(0) <- tmp_0_3\l    tmp_0_4 <- c(0)\l    tmp_0_5 <- tmp_0_4 > 0\l    if (!tmp_0_5) go to BLOCK4 else go to BLOCK5"]
3 -> 4 [label=true]
3 -> 5 [label=false]
4 [label="BLOCK 4\l    new variable c\l    tmp_4_0 <- c(0)\l    tmp_4_1 <- tmp_4_0 sub 1\l    c(1) <- tmp_4_1\l    go to BLOCK6"]
4 -> 6
5 [label="BLOCK 5\l    new variable a\l    a(3) <- 1\l    go to BLOCK6"]
5 -> 6
6 [label="BLOCK 6\l    c(2) = phi(c(1), c(0))\l    a(4) = phi(a(2), a(3))\l    new variable a\l    a(5) <- 3"]
}
